{
  "name": "mini-coding-agent",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "mini-agent": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/cli/main.ts",
    "eval": "bun src/evaluation/cli.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && bun -e \"import { cp, rm } from 'node:fs/promises'; await rm('dist/skills', { recursive: true, force: true }); await cp('src/skills', 'dist/skills', { recursive: true });\"",
    "start": "node dist/cli/main.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@langfuse/client": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "dotenv": "^16.6.1",
    "glob": "^13.0.6",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.5.0"
  }
}
